# 로컬 개발 환경 설정 예시
# 이 파일을 application-local.properties로 복사하고 실제 값으로 변경하세요
# application-local.properties는 .gitignore에 포함되어 깃헙에 업로드되지 않습니다

# 데이터베이스 설정
DB_URL=jdbc:mysql://localhost:3306/hackathon_db?serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_actual_password

# API 키 설정
SEOUL_CULTURE_API_KEY=your_actual_seoul_api_key
CHATGPT_API_KEY=your_actual_chatgpt_api_key
